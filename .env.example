# Скопируйте в .env и заполните: cp .env.example .env

# --- Telegram ---
# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=
# Ваш Telegram ID (узнать: @userinfobot). Сюда приходят отзывы из /feedback,
# на вас не действуют дневные лимиты.
ADMIN_TELEGRAM_ID=
# Ссылка на полный текст политики обработки данных; пусто — /privacy покажет краткую версию.
PRIVACY_URL=
# HTTPS-адрес mini app (веб-приложения). Бот ставит кнопку «Открыть» слева от поля ввода
# и отвечает на /app. Для разработки — туннель: cloudflared tunnel --url http://localhost:3000
MINI_APP_URL=
# Дневные лимиты на пользователя: ответы агента и токены GigaChat; 0 — без лимита.
USER_DAILY_MESSAGES=150
USER_DAILY_TOKENS=200000

# --- LLM ---
LLM_PROVIDER=gigachat
# Ключ авторизации из личного кабинета GigaChat API (developers.sber.ru).
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro

# --- PostgreSQL ---
POSTGRES_USER=expenses
# На сервере — длинный случайный пароль: openssl rand -hex 24
POSTGRES_PASSWORD=expenses
POSTGRES_DB=expenses

# --- Приложение ---
# dev — локальная разработка: запросы без подписи Telegram выполняются от имени
# AUTH_DEV_USER_ID, чтобы панель открывалась в обычном браузере. На сервере — prod
# (тогда AUTH_DEV_USER_ID игнорируется).
APP_ENV=dev
AUTH_DEV_USER_ID=
# Таймзона семьи: от неё считаются «сегодня», «вчера», «эта неделя».
APP_TIMEZONE=Europe/Moscow
LOG_LEVEL=info

# --- Продакшен (docker-compose.prod.yml, см. docs/deploy.md) ---
# Домен mini app без https://; его A-запись должна указывать на сервер. Из него
# собираются MINI_APP_URL (https://<домен>) и PRIVACY_URL (https://<домен>/privacy).
DOMAIN=
# Бэкапы базы: каждую ночь в BACKUP_HOUR_UTC:00 (0 = 03:00 по Москве), хранятся BACKUP_KEEP_DAYS дней.
BACKUP_HOUR_UTC=0
BACKUP_KEEP_DAYS=14
# Копия бэкапов в S3-совместимое хранилище (Yandex Object Storage, Selectel S3...); пусто — только на сервере.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
