# Скопируйте в .env и заполните: cp .env.example .env

# --- Telegram ---
# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=
# Telegram ID членов семьи через запятую. Пусто — бот отвечает всем.
# Свой ID бот подскажет, если написать ему, когда список уже задан.
ALLOWED_TELEGRAM_IDS=

# --- LLM ---
LLM_PROVIDER=gigachat
# Ключ авторизации из личного кабинета GigaChat API (developers.sber.ru).
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro

# --- PostgreSQL ---
POSTGRES_USER=expenses
POSTGRES_PASSWORD=expenses
POSTGRES_DB=expenses

# --- Приложение ---
# Таймзона семьи: от неё считаются «сегодня», «вчера», «эта неделя».
APP_TIMEZONE=Europe/Moscow
LOG_LEVEL=info
